# ── Athoo Website — environment variables ─────────────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env.

# ── API Server (artifacts/api-server) ─────────────────────────────────────────
# PostgreSQL connection string (Neon DB recommended)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Express session secret (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-random-32-char-string

# Port the API server listens on (default: 5000)
PORT=5000

# ── Frontend (artifacts/athoo-website) ────────────────────────────────────────
# Override the Render API base URL if you deploy the API elsewhere
# Defaults to https://thoo-api.onrender.com
VITE_API_BASE_URL=https://thoo-api.onrender.com

# ── Vercel (set in Vercel project settings, not .env) ─────────────────────────
# No additional env vars required for the frontend on Vercel.
# The API proxy in vercel.json forwards /api/* to VITE_API_BASE_URL.
