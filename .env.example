# ATHOO WEBSITE PRODUCTION ENVIRONMENT EXAMPLE
# Copy to .env locally or add these keys to Vercel/Render/VPS. Never commit real secrets.

# Database / Neon / PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Existing website/admin auth settings
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
AUTH_SECRET=CHANGE_ME_MIN_64_CHARS_RANDOM_SECRET
SESSION_SECRET=CHANGE_ME_MIN_64_CHARS_RANDOM_SECRET
JWT_SECRET=CHANGE_ME_MIN_64_CHARS_RANDOM_SECRET
SUPER_ADMIN_EMAIL=official@athoo.pk

# Public website / API
VITE_API_BASE_URL=https://thoo-api.onrender.com
VITE_SITE_URL=https://athoo.pk
API_BASE_URL=https://thoo-api.onrender.com
PUBLIC_API_BASE_URL=https://thoo-api.onrender.com
CORS_ORIGIN=https://athoo.pk,https://www.athoo.pk,https://admin.athoo.pk
BASE_PATH=/
PORT=8080
NODE_ENV=production

# Lead notifications / email
LEAD_NOTIFY_TO=official@athoo.pk
LEAD_EMAIL_FROM=official@athoo.pk
ADMIN_NOTIFICATION_EMAIL=official@athoo.pk
SUPPORT_EMAIL=support@athoo.pk
INFO_EMAIL=official@athoo.pk
EMAIL_PROVIDER=zoho

# Zoho SMTP / Nodemailer existing config
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=587
SMTP_USER=official@athoo.pk
SMTP_PASS=CHANGE_ME
SMTP_FROM=official@athoo.pk
ZOHO_SMTP_HOST=smtppro.zoho.com
ZOHO_SMTP_PORT=587
ZOHO_SMTP_USER=official@athoo.pk
ZOHO_SMTP_PASS=CHANGE_ME

# Optional Resend fallback
RESEND_API_KEY=

# Security / rate limit
RATE_LIMIT_PER_MINUTE=30

# Future portable services (kept as placeholders only)
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=athoo-media
R2_PUBLIC_URL=https://cdn.athoo.pk
ROUTING_PROVIDER=graphhopper
GEOCODING_PROVIDER=graphhopper
MAPS_PROVIDER=maplibre
GRAPHHOPPER_API_KEY=
PUSH_PROVIDER=expo
OTP_PROVIDER=whatsapp
WHATSAPP_PROVIDER=
SMS_PROVIDER=
REDIS_URL=redis://localhost:6379
