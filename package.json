{
  "name": "athoo-website-production",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:website",
    "dev:web": "pnpm run dev:website",
    "dev:website": "pnpm --filter @athoo/website run dev",
    "dev:api": "pnpm --filter @athoo/api run dev",
    "build": "pnpm run typecheck && pnpm run build:api && pnpm run build:web",
    "build:web": "pnpm --filter @athoo/website run build && node scripts/copy-website-dist.mjs",
    "build:website": "pnpm run build:web",
    "build:api": "pnpm --filter @athoo/api run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "typecheck:libs": "tsc --build",
    "start:api": "pnpm --filter @athoo/api run start",
    "db:schema": "pnpm --filter @athoo/db run push",
    "lint": "pnpm -r --if-present run lint",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@vercel/node": "^5.5.6",
    "@types/node": "^24.0.0",
    "prettier": "^3.8.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "pg": "^8.16.3"
  }
}
